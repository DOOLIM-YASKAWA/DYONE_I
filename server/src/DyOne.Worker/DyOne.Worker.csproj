    <None Include="python\**\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DyOne.Data\DyOne.Data.csproj" />
    <ProjectReference Include="..\DyOne.Spec\DyOne.Spec.csproj" />
  </ItemGroup>
</Project>
